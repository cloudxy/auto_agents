# ============================================================
# New API 中转站部署环境变量模板
# ------------------------------------------------------------
# 用法：cp .env.example .env 后逐项修改；.env 含密钥，严禁提交 git
#      （本目录 .gitignore 已忽略 .env / data/ / mysql-data/ / redis-data/）
# 随机密钥生成：openssl rand -hex 32（每个密钥单独执行一次）
# ============================================================

# ------------------------------------------------------------
# !!!!!!!!  醒目提示（必读）  !!!!!!!!
# new-api 初始管理员账号为 root / 123456，首次登录后必须立即修改密码
# （右上角头像 → 个人设置 → 修改密码）。该账号拥有渠道/令牌/租户全部
# 管理权限，弱口令 = 整站沦陷。生产部署务必完成本条再对外暴露端口。
# ------------------------------------------------------------

# --- 安全密钥（必改！各自执行 openssl rand -hex 32 生成）---
# SESSION_SECRET：会话签名密钥。泄露 = 可伪造登录态；更换后所有用户需重新登录
SESSION_SECRET=请改成随机字符串_openssl_rand_hex_32
# CRYPTO_SECRET：上游渠道真实 Key 的加密存储密钥。泄露 = 上游 Key 全部暴露；
# 设置后不可随意更换（更换后已加密的渠道 Key 将无法解密，需重建渠道）
CRYPTO_SECRET=请改成另一组随机字符串

# --- MySQL（仅生产版 docker-compose.yml 使用；SQLite 版可忽略本段）---
# 注意：MySQL 数据目录（./mysql-data）首次初始化后，再修改 *_PASSWORD 不会
# 自动生效（需进容器执行 ALTER USER，或删除数据目录重建——后者会丢库，先备份）
# root 密码：仅用于容器内健康检查与本机运维（DESC logs 验证等）
MYSQL_ROOT_PASSWORD=改成强root密码
# 业务账号（最小权限，仅授予下方库；MySQL 镜像约束：不能叫 root）
MYSQL_USER=newapi
MYSQL_PASSWORD=改成强业务密码
MYSQL_DATABASE=newapi

# --- Redis（仅生产版使用；SQLite 版可忽略本段）---
REDIS_PASSWORD=改成强redis密码

# --- 派生连接串（compose 自动拼装，无需手改；列出仅供核对/排障）---
# 生产版 new-api 实际读取：
#   SQL_DSN=${MYSQL_USER}:${MYSQL_PASSWORD}@tcp(mysql:3306)/${MYSQL_DATABASE}?charset=utf8mb4&parseTime=True&loc=Local
#   REDIS_CONN_STRING=redis://:${REDIS_PASSWORD}@redis:6379

# --- HTTPS / 会话 Cookie ---
# true 仅在 HTTPS 反代（Caddy/Nginx）就绪后保持；
# 纯 HTTP 直连试跑必须改 false，否则浏览器不回传会话 Cookie，表现为无法登录
SESSION_COOKIE_SECURE=true
# HTTPS 域名（可选）：限制会话 Cookie 仅在该域名下发送，如 https://api.example.com
SESSION_COOKIE_TRUSTED_URL=

# --- 对外端口 ---
# NEWAPI_BIND=0.0.0.0 时公网可直接访问 3000；
# 生产建议改 127.0.0.1（3000 仅本机可达，外部一律走 HTTPS 反代）
NEWAPI_BIND=0.0.0.0
NEWAPI_PORT=3000

# --- 其他 ---
TZ=Asia/Shanghai
LOG_LEVEL=info
