# ============================================================
# LiteLLM Proxy env template (independent compose)
# ------------------------------------------------------------
# Usage: cp .env.example .env then replace every placeholder.
# .env is gitignored. Never commit real master / salt / upstream keys.
# Generate: openssl rand -hex 32  (once per secret)
# ============================================================

# --- Gateway secrets (required in any real run) ---
# LITELLM_MASTER_KEY: admin / virtual-key parent. Prefix sk-
# LITELLM_SALT_KEY: encrypts provider credentials in THIS postgres.
#   Set once. Do not rotate as a normal rollback — export models first.
LITELLM_MASTER_KEY=sk-请改成随机字符串_openssl_rand_hex_32
LITELLM_SALT_KEY=sk-请改成另一组随机字符串_openssl_rand_hex_32

# --- Gateway Postgres (not platform MySQL; not app Alembic) ---
# Use URL-safe passwords (A-Za-z0-9). Special chars break DATABASE_URL.
# Changing the password after ./postgres-data is initialized does not
# update the role; ALTER USER or wipe the volume (destroys spend/keys).
POSTGRES_USER=litellm
POSTGRES_PASSWORD=请改成强密码_仅字母数字
POSTGRES_DB=litellm

# --- Bind ---
# Loopback default: Admin UI is operator-only, not a tenant product.
# Reverse-proxy if you must expose 4000; tenants must not hit this port.
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000

# --- Runtime config file ---
# Default compose mount is config.yaml.example (os.environ/* only).
# Generated file is gitignored. Do not put plaintext keys in either file.
# LITELLM_CONFIG=./config.gen.yaml

# --- Upstream keys (runtime inject). Empty is valid for compose config. ---
# config yaml must keep: api_key: os.environ/OPENAI_API_KEY
# Add more provider env vars to the litellm service when needed.
OPENAI_API_KEY=

TZ=Asia/Shanghai
