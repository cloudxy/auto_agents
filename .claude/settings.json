{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "dev-team": {
      "source": { "source": "directory", "path": "./.agents/plugins/dev-team" }
    },
    "sdlc-workflow": {
      "source": { "source": "directory", "path": "./.agents/plugins/sdlc-workflow" }
    },
    "drama-skills": {
      "source": { "source": "directory", "path": "./.agents/plugins/drama-skills" }
    },
    "oh-story-skills": {
      "source": { "source": "directory", "path": "./.agents/plugins/oh-story" }
    }
  },
  "enabledPlugins": {
    "dev-team@dev-team": true,
    "sdlc-workflow@sdlc-workflow": true,
    "drama-skills@drama-skills": true,
    "oh-story@oh-story-skills": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/inject_context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard_meta.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/suggest_memory.sh"
          }
        ]
      }
    ]
  }
}
