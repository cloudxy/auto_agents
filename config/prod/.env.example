# 生产环境 .env 模板（P1-1 修复配套）
#
# 用法：复制为 config/prod/.env（gitignored），由部署脚本注入真实值。
#
# 键名规范：
# - 嵌套配置键：AUTO_AGENTS_ 前缀 + 双下划线分层（Dynaconf 环境变量约定），
#   如 MYSQL.DEFAULT.PASSWORD → AUTO_AGENTS_MYSQL__DEFAULT__PASSWORD
# - 裸键（无前缀）：仅限代码 os.getenv 直读的键（LLM_API_KEY / LLM_ENCRYPTION_KEY）
# - ⚠️ Dynaconf 的 .env 加载不做 ${VAR} shell 展开——占位值必须由部署脚本
#   直接替换为真实值，不能写 "${PROD_XXX}" 形式（旧模板即此问题导致启动即拒）

# --- 数据库 / 缓存 ---
AUTO_AGENTS_MYSQL__DEFAULT__PASSWORD=
AUTO_AGENTS_REDIS__DEFAULT__PASSWORD=

# --- 签名密钥（必填：JWT 守卫与 Webhook 守卫都会拒绝默认占位符启动） ---
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTO_AGENTS_JWT__SECRET_KEY=
# Backend 与 Scrapy 两侧必须一致（HMAC 回调签名）
AUTO_AGENTS_WEBHOOK__SECRET_KEY=

# --- LLM（可选，代码经 os.getenv 直读，保持裸键） ---
# LLM_API_KEY=
# LLM_ENCRYPTION_KEY=
