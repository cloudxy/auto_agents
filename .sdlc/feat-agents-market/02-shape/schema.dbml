// schema.dbml · feat-agents-market
// 上游：02-shape/db-spec.md ｜ 下游：迁移 050（T-05）→ backend ORM
// 泳道：L3｜作者：dba 帽｜日期：2026-09-15｜contract §5 数据契约
// 变更面：capability_assets +featured +examples（与迁移 050 一一对应）；其余三表为
//   本特性查询路径上的既有表（全列登记，零变更）。本轮零新表、零索引变更。
// 规范：每个索引注释标注 db-spec §4 访问模式 ID；枚举用 enum 块登记文档合法值，
//   物理层由 ORM String 列 + 应用层校验落地（不用数据库 ENUM 类型——改值要 DDL）。
// 已有表 = live 全列（SHOW COLUMNS 实测物理序，MySQL 8.0.42 / head 049）∪ 050 加列接表尾。

Project feat_agents_market {
  database_type: 'MySQL'
  note: '.agents 资产能力市场：货架四类卡片 + 排序三档 + 详情示例 + 非破坏同步。纯加法 050（featured/examples），零新表。'
}

// ─────────────────────────────────────────────
// 枚举：文档合法值（物理层 String + 应用校验）
// ─────────────────────────────────────────────

enum asset_type {
  skill
  plugin
  command
  agent
  team
  expert       [note: 'expand 一周期可读；映射 → agent']
  expert_team  [note: 'expand 一周期可读；映射 → team']
}

enum listing_state {
  unlisted     [note: '商店不可见（dev-team 合并超集强制此态）']
  listed       [note: '商店可见可新订']
  coming_soon  [note: '商店可见不可订（既有第三态，本轮不改机器）']
}

enum asset_governance_status {
  experimental
  testing
  stable        [note: '.agents 同步行固定 stable']
  recommended
  deprecated
  blacklist
}

enum source_type {
  self_built    [note: '.agents 同步行固定 self_built']
  network_imported
  marketplace_crawled
  source_indexed
}

// ─────────────────────────────────────────────
// 表
// ─────────────────────────────────────────────

Table capability_assets {
  id                      int                [pk, increment, note: '代理主键']
  asset_type              asset_type         [not null, note: '目录类型维度（公开五类 + expand 双值）']
  name                    varchar(128)       [not null, note: '目录名；类型内存活唯一（唯一键含 alive_flag）']
  title                   varchar(256)       [null, default: ``]
  description             varchar(1024)      [null, note: '卡片副文案，同步截断 1024']
  category                varchar(64)        [not null, default: `uncategorized`]
  status                  asset_governance_status [not null, default: `experimental`, note: '治理状态；货架仅 stable/recommended 过闸']
  source_type             source_type        [not null, default: `self_built`]
  source_url              varchar(512)       [null, default: ``]
  source_author           varchar(128)       [null, default: ``]
  content_hash            varchar(64)        [null, default: ``, note: 'md+图 sha256；upsert 内容判重（GWT-07.3）']
  score                   decimal(3, 1)      [null]
  ai_suggested_score      decimal(3, 1)      [null]
  tier                    varchar(2)         [null]
  reviewed_by             varchar(64)        [null]
  reviewed_at             datetime           [null]
  similar_to              json               [null]
  file_path               varchar(512)       [null, note: '.agents/ 前缀 = 仓库根相对读取（WIP 缺陷 A 修复锚）']
  sync_state              varchar(16)        [not null, default: `ok`, note: 'prune 置 gone']
  tenant_id               int                [null, note: '平台级公共资产恒 NULL（豁免白名单）']
  detail_id               int                [null, note: '类型化细节表行 id']
  created_at              datetime           [null, default: `CURRENT_TIMESTAMP`]
  updated_at              datetime           [null, note: 'ON UPDATE 跳变；latest/smart 排序键（GWT-04.1/04.2）']
  deleted_at              datetime           [null, note: 'NULL=存活；软删唯一显式动作可达（spec §3.1）']
  created_by              varchar(64)        [null]
  updated_by              varchar(64)        [null]
  alive_flag              smallint           [null, note: 'VIRTUAL 生成列：CASE WHEN deleted_at IS NULL THEN 1 ELSE NULL END；唯一键组件']
  listing_state           listing_state      [not null, default: `unlisted`, note: '与 status / 许可 / 黑名单独立（三态机器本轮不改）']
  license                 varchar(64)        [null, note: '同步拷贝的许可标识（现在）；NULL=未声明']
  public_license_override smallint           [not null, default: `0`, note: '超管特例放行']
  host_compat             json               [null, note: 'NULL=四宿主可订；[]=都不可订']
  listed_at               datetime(6)        [null, note: '最近一次 listed；不参与本轮排序']
  source_id               int                [null, ref: > capability_sources.id, note: 'NULL=第一方窗口（.agents 同步行全部 NULL——prune 候选判据）']
  origin_ref              varchar(256)       [null]
  origin_local_name       varchar(128)       [null]
  origin_plugin_name      varchar(128)       [null, note: '卡片副标题来源（所属插件）']
  alias_origin_refs       json               [null, note: '非查询列']
  writable                smallint           [not null, default: `1`]
  logo                    varchar(512)       [null, note: '049：icon 相对仓库路径']
  background              varchar(512)       [null, note: '049：背景图相对仓库路径']
  featured                smallint           [not null, default: `0`, note: '050 新增：FR-04 综合序置顶标志 0/1；不进同步 _desired 白名单']
  examples                json               [null, note: '050 新增：帮你做示例 list[str] ≤20×200 字（应用层校验）；NULL=未维护（抽屉隐藏区块）']

  indexes {
    (asset_type, name, alive_flag) [unique, name: 'uq_asset_type_name_alive']
    // 服务 P-05（同步/导入 upsert 判重）+ P-06（详情/治理点查，EXPLAIN ref rows=1）
    // 三职：upsert 判重（GWT-01.2/07.3）+ 并发兜底（GWT-01.7 IntegrityError）+ 点查索引
    // alive_flag 生成列使软删行脱离唯一约束 → prune 后同键可重建

    (listing_state, status, asset_type, category) [name: 'idx_assets_listing_status_type_cat']
    // 服务 P-01/P-02/P-03（货架过滤链）候选：实测 194 行、过滤命中 93% 下
    // 优化器弃用选全表扫（key=NULL, ANALYZE 0.587ms）——正确计划，保留不删

    (asset_type) [name: 'ix_capability_assets_asset_type']
    // 服务 P-07（治理 7-tab 列表；EXPLAIN ref key_len=66 rows=12）

    (category) [name: 'ix_capability_assets_category']
    // 既有 legacy 单列，本轮评估不动（无 Top-N 模式单独命中，保留避免破坏性变更）

    (status) [name: 'ix_capability_assets_status']
    // 既有 legacy 单列，同上保留

    (source_id, origin_ref, alive_flag) [name: 'idx_assets_source_origin_alive']
    // 既有 src_sync 注册表路径，非本轮 Top-N（prune 走 source_id IS NULL 反向判定）

    // 已评估不建（db-spec §5）：(featured)/(featured,updated_at)——基数≈2 且过滤集 93% 命中，
    // 排序 194(10x=2000) 行内存完成；(updated_at)——无按时间过滤模式；
    // (listing_state,asset_type,updated_at) 窄化键——优化器已实测拒绝同类候选；
    // examples 生成列/多值索引——非查询列。
  }

  note: '统一资产目录（治理真相源）。一行 = 一个存活资产 (asset_type, name) 当前代。本轮 +featured +examples（050，治理字段与同步 _desired 白名单解耦）。'
}

Table capability_installs {
  id          int         [pk, increment]
  tenant_id   int         [not null, note: '隔离列；禁止进 TENANT_EXEMPT_TABLES']
  asset_id    int         [not null, ref: > capability_assets.id]
  host        varchar(16) [not null, note: 'grok/zcode/kimi/claude']
  enabled     smallint    [not null, default: `1`]
  trusted     smallint    [not null, default: `0`]
  deleted_at  datetime    [null]
  alive_flag  smallint    [null, note: 'VIRTUAL 生成列；唯一键组件']
  created_by  varchar(64) [null]
  updated_by  varchar(64) [null]
  created_at  datetime    [not null, default: `CURRENT_TIMESTAMP`, note: '订阅成功时刻（业务时间）']
  updated_at  datetime    [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (tenant_id, asset_id, host, alive_flag) [unique, name: 'uq_installs_tenant_asset_host_alive']
    // 业务唯一：一企业 × 一资产 × 一宿主 存活一代（软删脱离约束可重订）

    (asset_id) [name: 'idx_installs_asset']
    // 服务 P-03（「最热」档派生表 GROUP BY asset_id；EXPLAIN type=index Using where）
  }

  note: '订阅表。「最热」排序计数来源——实时聚合不落汇总列（附加 a 不造假）。本轮零变更。'
}

Table capability_sources {
  id            int         [pk, increment]
  name          varchar(128) [not null, note: '源稳定名；存活唯一']
  source_kind   varchar(16) [not null, note: 'local/git/url；禁用列名 type']
  uri           varchar(512) [not null]
  is_enabled    smallint    [not null, default: `1`]
  last_sync_at  datetime    [null, note: 'NULL=从未同步成功结束']
  last_succeeded int        [not null, default: `0`]
  last_failed   int         [not null, default: `0`]
  last_error    varchar(512) [null]
  tenant_id     int         [null, note: '平台级恒 NULL']
  deleted_at    datetime    [null]
  alive_flag    smallint    [null, note: 'VIRTUAL 生成列；唯一键组件']
  created_at    datetime    [null, default: `CURRENT_TIMESTAMP`]
  updated_at    datetime    [null]

  indexes {
    (name, alive_flag) [unique, name: 'uq_sources_name_alive']
    // 既有：源名存活唯一（src_sync 路径，非本轮 Top-N；登记供 FK 对端完整性）
  }

  note: '外部源注册表。仅作 capability_assets.source_id 的引用对端登记，本轮零变更。'
}

Table product_events {
  id                   int         [pk, increment]
  occurred_at          datetime    [not null, note: '业务时间 UTC']
  event_name           varchar(64) [not null, note: 'FR-08 四字面量：import_completed/import_failed/sync_completed/sync_failed/detail_opened']
  tenant_id            int         [null, note: '事件主语（可 NULL），非隔离归属']
  actor_user_id        int         [null, note: '匿名 NULL；不加 FK']
  anonymous_id         varchar(64) [null]
  role                varchar(32)  [null, note: 'FR-08 who：actor_role 落此处或 props']
  props                json        [null, note: '非查询列：source/files/assets_created/... 四事件字段（GWT-08.1..08.4）']
  created_at           datetime    [not null, default: `CURRENT_TIMESTAMP`]
  updated_at           datetime    [not null, default: `CURRENT_TIMESTAMP`, note: 'R-AUD；应用永不更新']
  is_internal_fixture  smallint    [null, note: '1=是 0=否 NULL=旧事件']

  indexes {
    (event_name, occurred_at) [name: 'idx_product_events_name_occurred']
    // 服务 P-08（FR-08 事件复盘检索：按事件名 + 时间窗）

    (tenant_id, occurred_at) [name: 'idx_product_events_tenant_occurred']
    // 既有：按企业检索（非本轮 Top-N，保留）

    (event_name, is_internal_fixture, occurred_at) [name: 'idx_product_events_name_fixture_occurred']
    // 既有：夹具过滤检索（非本轮 Top-N，保留）
  }

  note: '产品事件追加表。FR-08 四类治理事件落点，本轮零变更（复用 emit_product_event 基建）。'
}

// ─────────────────────────────────────────────
// 关系（默认 RESTRICT，删除逻辑放应用层显式处理）
// ─────────────────────────────────────────────

Ref: capability_installs.asset_id > capability_assets.id [delete: restrict]
// N:1。RESTRICT：有订阅的资产行禁止物理删（本域本就软删 + prune 仅置 deleted_at，不动 installs——计数保留，spec §3.1）

Ref: capability_assets.source_id > capability_sources.id [delete: restrict]
// N:1 可空。RESTRICT：登记源被引用时禁止删；NULL = 第一方窗口（.agents 同步行）
