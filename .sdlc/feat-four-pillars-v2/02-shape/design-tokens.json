{
  "$comment": [
    "feat-four-pillars-v2 设计 token 合同。泳道：L4。日期：2026-09-08。",
    "前端只消费 semantic 层，禁止硬编码 hex。",
    "三层：primitive → semantic → component。",
    "品牌家族沿用 shared BRAND_TOKENS；semantic.primary 用 #0958d9 以满足白字 4.5:1（#1677ff 为 4.10:1，仅 primitive 装饰）。",
    "对比度见 _contrastAudit。Q-VOICE 未关：不把 telemetry 铺满 Hero。"
  ],

  "primitive": {
    "color": {
      "brandBlue": {
        "50": "#e6f4ff",
        "100": "#bae0ff",
        "500": "#1677ff",
        "600": "#0958d9",
        "700": "#003eb3"
      },
      "cyan": {
        "50": "#e6fffb",
        "500": "#13c2c2",
        "700": "#006d75"
      },
      "red": {
        "50": "#fff1f0",
        "500": "#ff4d4f",
        "600": "#cf1322",
        "700": "#a8071a"
      },
      "gold": {
        "50": "#fffbe6",
        "600": "#ad4e00",
        "700": "#874d00"
      },
      "green": {
        "50": "#f6ffed",
        "600": "#237804",
        "700": "#135200"
      },
      "ink": {
        "900": "#001529",
        "800": "#003a5c"
      },
      "gray": {
        "0": "#ffffff",
        "50": "#fafafa",
        "100": "#f5f5f5",
        "200": "#f0f0f0",
        "300": "#d9d9d9",
        "400": "#8c8c8c",
        "500": "#737373",
        "600": "#595959",
        "700": "#434343",
        "900": "#141414"
      }
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "full": "9999px"
    },
    "fontFamily": {
      "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "32px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.25,
      "base": 1.5,
      "relaxed": 1.6
    },
    "duration": {
      "fast": "150ms",
      "base": "250ms",
      "slow": "400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)"
    }
  },

  "semantic": {
    "$comment": "前端消费这一层。按语义命名。",

    "color": {
      "primary": { "value": "{primitive.color.brandBlue.600}", "$comment": "主按钮、链接。白字 6.16:1" },
      "primaryHover": { "value": "{primitive.color.brandBlue.700}" },
      "primarySubtle": { "value": "{primitive.color.brandBlue.50}" },
      "onPrimarySubtle": { "value": "{primitive.color.brandBlue.700}", "$comment": "预告角标文字" },

      "danger": { "value": "{primitive.color.red.600}" },
      "dangerHover": { "value": "{primitive.color.red.700}" },
      "dangerSubtle": { "value": "{primitive.color.red.50}" },
      "onDangerSubtle": { "value": "{primitive.color.red.700}" },

      "warning": { "value": "{primitive.color.gold.700}" },
      "warningSubtle": { "value": "{primitive.color.gold.50}" },
      "onWarningSubtle": { "value": "{primitive.color.gold.700}" },

      "success": { "value": "{primitive.color.green.600}" },
      "successSubtle": { "value": "{primitive.color.green.50}" },
      "onSuccessSubtle": { "value": "{primitive.color.green.700}" },

      "telemetry": { "value": "{primitive.color.cyan.700}", "$comment": "仅采集管线节点一处，不作正文" },
      "telemetrySubtle": { "value": "{primitive.color.cyan.50}" },
      "onTelemetrySubtle": { "value": "{primitive.color.cyan.700}" },

      "textPrimary": { "value": "{primitive.color.gray.900}" },
      "textSecondary": { "value": "{primitive.color.gray.600}", "$comment": "7.0:1；禁止再浅到 gray.400 当事文字" },
      "textDisabled": { "value": "{primitive.color.gray.400}" },
      "textInverse": { "value": "{primitive.color.gray.0}" },

      "surface": { "value": "{primitive.color.gray.0}" },
      "surfaceSunken": { "value": "{primitive.color.gray.50}" },
      "surfaceRaised": { "value": "{primitive.color.gray.100}" },
      "ink": { "value": "{primitive.color.ink.900}", "$comment": "官网 Hero/页脚/后台 Sider；删 #0b1830 分叉" },

      "border": { "value": "{primitive.color.gray.200}" },
      "borderStrong": { "value": "{primitive.color.gray.500}", "$comment": "输入框/卡 hover 边，4.74:1 ≥ 3:1" },
      "focusRing": { "value": "{primitive.color.brandBlue.600}" },

      "listingComingSoonBg": { "value": "{primitive.color.brandBlue.50}" },
      "listingComingSoonFg": { "value": "{primitive.color.brandBlue.700}" },
      "listingUnlistedFg": { "value": "{primitive.color.gray.600}" },
      "quotaWarn": { "value": "{primitive.color.gold.700}" },
      "quotaDanger": { "value": "{primitive.color.red.600}" }
    },

    "text": {
      "$comment": "字号+字重+行高成套。官网正文行长 <80 字。",
      "heading1": { "fontSize": "{primitive.fontSize.3xl}", "fontWeight": "{primitive.fontWeight.bold}", "lineHeight": "{primitive.lineHeight.tight}", "fontFamily": "{primitive.fontFamily.sans}" },
      "heading2": { "fontSize": "{primitive.fontSize.2xl}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.lineHeight.tight}", "fontFamily": "{primitive.fontFamily.sans}" },
      "heading3": { "fontSize": "{primitive.fontSize.xl}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.lineHeight.base}", "fontFamily": "{primitive.fontFamily.sans}" },
      "bodyLarge": { "fontSize": "{primitive.fontSize.lg}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.lineHeight.relaxed}", "fontFamily": "{primitive.fontFamily.sans}" },
      "body": { "fontSize": "{primitive.fontSize.base}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.lineHeight.relaxed}", "fontFamily": "{primitive.fontFamily.sans}" },
      "bodyStrong": { "fontSize": "{primitive.fontSize.base}", "fontWeight": "{primitive.fontWeight.medium}", "lineHeight": "{primitive.lineHeight.relaxed}", "fontFamily": "{primitive.fontFamily.sans}" },
      "caption": { "fontSize": "{primitive.fontSize.xs}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.lineHeight.base}", "fontFamily": "{primitive.fontFamily.sans}" },
      "code": { "fontSize": "{primitive.fontSize.sm}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.lineHeight.base}", "fontFamily": "{primitive.fontFamily.mono}", "$comment": "市场详情纯文本 pre" }
    },

    "space": {
      "insetXs": "{primitive.space.1}",
      "insetSm": "{primitive.space.2}",
      "insetMd": "{primitive.space.4}",
      "insetLg": "{primitive.space.6}",
      "stackSm": "{primitive.space.2}",
      "stackMd": "{primitive.space.4}",
      "stackLg": "{primitive.space.8}",
      "stackXl": "{primitive.space.12}"
    },

    "radius": {
      "control": "{primitive.radius.sm}",
      "card": "{primitive.radius.md}",
      "modal": "{primitive.radius.lg}",
      "pill": "{primitive.radius.full}"
    },

    "shadow": {
      "card": { "value": "0 1px 2px rgba(0,21,41,0.06)" },
      "dropdown": { "value": "0 4px 12px rgba(0,21,41,0.10)" },
      "modal": { "value": "0 16px 32px rgba(0,21,41,0.16)" }
    },

    "motion": {
      "hover": { "duration": "{primitive.duration.fast}", "easing": "{primitive.easing.standard}" },
      "modalEnter": { "duration": "{primitive.duration.base}", "easing": "{primitive.easing.decelerate}" },
      "pageEnter": { "duration": "{primitive.duration.slow}", "easing": "{primitive.easing.decelerate}", "$comment": "官网仅 Hero 一次；禁止每节 fade-slide。prefers-reduced-motion=none" },
      "reducedMotion": { "duration": "0ms" }
    },

    "breakpoint": {
      "$comment": "断点必须在 tokens 里。官网 sm 起 CTA 仍 ≥44px。治理七叶 md 以下 Tabs 滚动。",
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },

    "size": {
      "touchTarget": { "value": "44px", "$comment": "官网 CTA / 弹窗主按钮" },
      "focusRingWidth": { "value": "2px" },
      "adminControlMin": { "value": "32px", "$comment": "antd 表内链接按钮高度下限；周围热区仍尽量 44" }
    }
  },

  "component": {
    "$comment": "可选。指向 semantic。",
    "buttonPrimary": {
      "bg": "{semantic.color.primary}",
      "fg": "{semantic.color.textInverse}",
      "bgHover": "{semantic.color.primaryHover}",
      "radius": "{semantic.radius.control}",
      "minHeight": "{semantic.size.touchTarget}"
    },
    "comingSoonBadge": {
      "bg": "{semantic.color.listingComingSoonBg}",
      "fg": "{semantic.color.listingComingSoonFg}",
      "radius": "{semantic.radius.pill}"
    },
    "unlistedRow": {
      "fg": "{semantic.color.listingUnlistedFg}",
      "bg": "{semantic.color.surfaceSunken}"
    },
    "dutyDegradedAlert": {
      "bg": "{semantic.color.warningSubtle}",
      "fg": "{semantic.color.onWarningSubtle}"
    },
    "testConnectionFail": {
      "bg": "{semantic.color.dangerSubtle}",
      "fg": "{semantic.color.onDangerSubtle}"
    },
    "officialCard": {
      "radius": "{semantic.radius.card}",
      "shadow": "{semantic.shadow.card}",
      "hoverTransform": "none",
      "hoverBorder": "{semantic.color.borderStrong}"
    },
    "skillBodyPre": {
      "text": "{semantic.text.code}",
      "bg": "{semantic.color.surfaceSunken}"
    }
  },

  "_contrastAudit": {
    "$comment": "WCAG AA：正文 4.5:1，大字 3:1，UI 边界 3:1。设计阶段已验。",
    "checked": [
      { "pair": "textPrimary on surface", "ratio": "18.42:1", "required": "4.5:1", "pass": true },
      { "pair": "textSecondary on surface", "ratio": "7.00:1", "required": "4.5:1", "pass": true },
      { "pair": "textSecondary on surfaceSunken", "ratio": "6.71:1", "required": "4.5:1", "pass": true },
      { "pair": "textInverse on primary", "ratio": "6.16:1", "required": "4.5:1", "pass": true },
      { "pair": "textInverse on danger", "ratio": "5.57:1", "required": "4.5:1", "pass": true },
      { "pair": "textInverse on ink", "ratio": "18.43:1", "required": "4.5:1", "pass": true },
      { "pair": "onDangerSubtle on dangerSubtle", "ratio": "7.04:1", "required": "4.5:1", "pass": true },
      { "pair": "onWarningSubtle on warningSubtle", "ratio": "6.53:1", "required": "4.5:1", "pass": true },
      { "pair": "onSuccessSubtle on successSubtle", "ratio": "9.15:1", "required": "4.5:1", "pass": true },
      { "pair": "onPrimarySubtle on primarySubtle", "ratio": "8.01:1", "required": "4.5:1", "pass": true },
      { "pair": "listingComingSoonFg on listingComingSoonBg", "ratio": "8.01:1", "required": "4.5:1", "pass": true },
      { "pair": "listingUnlistedFg on surfaceSunken", "ratio": "6.71:1", "required": "4.5:1", "pass": true },
      { "pair": "onTelemetrySubtle on telemetrySubtle", "ratio": "5.82:1", "required": "4.5:1", "pass": true },
      { "pair": "borderStrong on surface", "ratio": "4.74:1", "required": "3:1", "pass": true },
      { "pair": "focusRing on surface", "ratio": "6.16:1", "required": "3:1", "pass": true },
      { "pair": "success on surface", "ratio": "5.59:1", "required": "4.5:1", "pass": true },
      { "pair": "warning on surface", "ratio": "6.79:1", "required": "4.5:1", "pass": true }
    ],
    "rejected": [
      { "pair": "textInverse on brandBlue.500 #1677ff", "ratio": "4.10:1", "reason": "不足正文 4.5:1，故 semantic.primary 用 brandBlue.600" },
      { "pair": "cyan.500 #13c2c2 on surface", "ratio": "2.21:1", "reason": "禁止当事文字/角标字；仅 ink 上非文字装饰且本轮默认不用" },
      { "pair": "rgba(0,0,0,0.45) on surface", "ratio": "<4.5:1", "reason": "现网 --site-text-secondary 作废，改 textSecondary gray.600" }
    ],
    "notes": [
      "textSecondary 不要再调浅。",
      "禁用态无对比度要求，必须另有文字/tooltip 说明原因。",
      "完整 WCAG 需辅助技术实测。"
    ]
  },

  "_a11yNotes": {
    "notOnlyColor": "状态配图标或文字：错误 ✕、警告 ⚠、成功 ✓、预告「预告」、正品/伪装/不可用",
    "focusVisible": "focusRing 2px 必须可见；禁止 outline:none 无替代",
    "iconButtonLabels": {
      "testConnection": "测试连接「{name}」",
      "deleteProvider": "删除供应商「{name}」",
      "deleteTask": "删除任务 {id}",
      "uninstall": "卸载「{name}」在 {host} 的安装",
      "verifyPlugin": "验证插件「{name}」",
      "more": "更多操作",
      "close": "关闭",
      "refreshDuty": "刷新值班页"
    },
    "heading": "每页一个 h1 = pageTitleFor / 官网页名",
    "reducedMotion": "关掉 Hero infinite glow 与每节 fade-slide；modalEnter 可降为 0ms"
  }
}
