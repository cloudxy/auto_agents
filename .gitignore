# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
*.egg-info/
dist/
build/

# UV
# 根 uv.lock 应提交以保证可复现构建；子项目 lock 由 workspace 接管，不应存在

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
backend/logs/
*.log

# Runtime & Temp (不提交)
runtime/
temp/

# Files (不提交，但保留目录结构)
files/uploads/*
files/downloads/*
files/exports/*
!files/uploads/.gitkeep
!files/downloads/.gitkeep
!files/exports/.gitkeep

# Environment
.env
.env.local
config/**/.env
config/.secrets.yml

# OS
.DS_Store
Thumbs.db

# Testing
.coverage
.pytest_cache/
htmlcov/

.claude/*
!.claude/rules/
!.claude/skills
!.claude/agents/
!.claude/hooks/
!.claude/memory/
!.claude/IDENTITY.md
!.claude/SOUL.md
!.claude/MEMORY.md
!.claude/settings.json
.claude/settings.local.json
.lingma/*
.gemini/*
ai_tool/*
.qoder/
.idea/*

# 运行期导出数据（storage/exports 等由 STORAGE 配置指向）
storage/

docs/*
# 发布公告随仓库提交（其余 docs 内容不入库）
!docs/release-notes-2026-08-30.md
