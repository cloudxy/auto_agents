# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
*.egg-info/
dist/
build/

# UV
# 根 uv.lock 应提交以保证可复现构建；子项目 lock 由 workspace 接管，不应存在

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
backend/logs/
*.log

# Runtime & Temp (不提交)
runtime/
temp/

# Files (不提交，但保留目录结构)
files/uploads/*
files/downloads/*
files/exports/*
!files/uploads/.gitkeep
!files/downloads/.gitkeep
!files/exports/.gitkeep

# Environment
.env
.env.local
config/**/.env
# 生产 .env 模板随仓库分发（键名规范 + ${} 不展开警示，P1-1）
!config/prod/.env.example
config/.secrets.yml

# OS
.DS_Store
Thumbs.db

