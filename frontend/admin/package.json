{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@tanstack/react-query": "^5.104.3",
    "antd": "^6.6.4",
    "axios": "^1.15.0",
    "dayjs": "^1.11.23",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "jest --maxWorkers=2",
    "e2e": "NO_PROXY=127.0.0.1,localhost,::1 no_proxy=127.0.0.1,localhost,::1 playwright test"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/src/setupAntdRender.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            [
              "@babel/preset-react",
              {
                "runtime": "automatic"
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "\\.(svg|png|jpe?g|gif|webp)$": "<rootDir>/src/__mocks__/fileMock.js"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@ant-design|antd|rc-|@rc-component|@auto-agents|react-markdown|remark-|unified|micromark|mdast-util-|mdast-|unist-util-|unist-|hast-util-|hast-|estree-util-|estree-|vfile|property-information|parse-entities|stringify-entities|markdown-table|space-separated-tokens|comma-separated-tokens|character-entities|character-reference|decode-named-character-reference|@ungap/structured-clone|is-plain-obj|is-alphabetical|is-alphanumerical|is-decimal|is-hexadecimal|longest-streak|html-url-attributes|trim-lines|zwitch|trough|bail|ccount|web-namespaces|devlop|escape-string-regexp))"
    ],
    "testTimeout": 120000
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
