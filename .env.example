# 环境变量示例（复制为 config/<env>/.env 后填写；切勿提交真实密钥）
# Dynaconf 加载顺序：default/*.yml → <env>/*.yml → <env>/.env → 环境变量 AUTO_AGENTS_*
#
# 键命名约定（与 config/local/.env 既有写法一致）：
#   - 嵌套键：AUTO_AGENTS_ 前缀 + 双下划线，如 JWT.SECRET_KEY → AUTO_AGENTS_JWT__SECRET_KEY
#   - 扁平密码键：AUTO_AGENTS_MYSQL_DEFAULT_PASSWORD（settings 读取）
#     与裸键 MYSQL_DEFAULT_PASSWORD（os.getenv 读取）等效，二选一即可
#   - 裸键（无前缀）：APP_ENV / LLM_API_KEY / LLM_ENCRYPTION_KEY 由代码 os.getenv 直接读取
#
# ⚠️ 安全约定：以下全部为注释化占位（不启用真实值）。
#    含 change-me-in-production 默认值的项在生产环境必须覆盖，否则视为配置事故。

# ============================================================
# 一、应用基础
# ============================================================

# 环境标识：决定加载 config/<env>/ 覆盖文件（local / dev / prod，默认 local）
# 由 config/__init__.py 以 os.getenv("APP_ENV") 读取，非 AUTO_AGENTS_ 前缀体系
# APP_ENV=local

# ============================================================
# 反代信任头（config/default/api.yml；uvicorn X-Forwarded-For 收口）
# ============================================================

# 是否信任代理头（X-Forwarded-For / X-Forwarded-Proto；uvicorn proxy_headers）
# AUTO_AGENTS_API__PROXY_HEADERS=true

# 信任的代理出口 IP（逗号分隔；uvicorn forwarded_allow_ips）
# ⚠️ 接入反向代理后必须收紧为自家反代出口 IP；过宽（如 "*"）会允许客户端
#    伪造 X-Forwarded-For 绕过按 IP 的注册限流。默认仅信任本机。
# AUTO_AGENTS_API__FORWARDED_ALLOW_IPS=127.0.0.1

# ============================================================
# 二、数据库 / 缓存密码（占位键由 config/<env>/{mysql,redis}.yml 引用）
# ============================================================

# MySQL 主实例密码（MYSQL.DEFAULT.PASSWORD 占位；生产必须强密码）
# AUTO_AGENTS_MYSQL_DEFAULT_PASSWORD=change-me-in-production

# Redis 主实例密码（REDIS.DEFAULT.PASSWORD 占位）
# AUTO_AGENTS_REDIS_DEFAULT_PASSWORD=change-me-in-production

# ============================================================
# 三、签名 / 鉴权密钥（默认值 change-me-in-production 仅限本地开发）
# ============================================================

# JWT 签名密钥（config/default/jwt.yml）。⚠️ 生产沿用默认值将导致令牌可被伪造
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTO_AGENTS_JWT__SECRET_KEY=

# Webhook 回调签名密钥（config/default/webhook.yml，Backend 与 Scrapy 必须一致）
# ⚠️ 生产沿用默认值将导致采集回调可被伪造；校验算法 HMAC-SHA256(secret, "{ts}.{body}")
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTO_AGENTS_WEBHOOK__SECRET_KEY=

# 外部 API 密钥列表（config/default/external_api.yml；JSON 数组字符串）
# 默认空数组 = 一律 401 拒绝；调用方需携带 X-API-Key 且命中列表才放行
# AUTO_AGENTS_EXTERNAL_API__API_KEYS='["your-api-key-1","your-api-key-2"]'

# ============================================================
# 四、New API 中转站对接（config/default/newapi.yml；敏感项禁入 yml）
# ============================================================

# new-api 管理员 AccessToken（管理 API 鉴权；渠道调度器/探针共用）
# AUTO_AGENTS_NEWAPI__ACCESS_TOKEN=

# new-api 数据库连接串（渠道用量只读聚合，调度器窗口统计用）
# AUTO_AGENTS_NEWAPI__DB_DSN=mysql+aiomysql://user:pass@host:3306/new-api-db

# 中转站 API Key（sk- 开头，探针调 /v1/chat/completions；留空回退 ACCESS_TOKEN）
# AUTO_AGENTS_NEWAPI__PROBE_API_KEY=

# ============================================================
# 五、通知渠道（config/default/notify.yml）
# ============================================================

# 邮件渠道 SMTP 密码（SMTP_SSL 默认 465 端口；缺省该渠道自动跳过）
# AUTO_AGENTS_NOTIFY__EMAIL__SMTP_PASSWORD=

# ============================================================
# 六、LLM 智能采集（config/default/llm.yml 的密钥补充）
# ============================================================

# OpenAI 兼容服务的 API Key；仅配置后 AI 规划/自动修复可用（LLM.ENABLED 也需为 true）
# 密钥只走 .env / 环境变量，禁止写入任何 yml 或代码
# LLM_API_KEY=

# LLM 供应商密钥加密主密钥（Fernet）：用于 llm_providers.api_key_encrypted 的加解密；
# 未配置时保存/更新带 api_key 的请求直接拒绝（不降级明文入库）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LLM_ENCRYPTION_KEY=
